# GreenTube — shared environment template
# Copy to services/api/.env (and others) as needed. Never commit real secrets.

# API
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (Postgres — auth/events; optional if using catalog-only dev mode)
DATABASE_URL=postgresql+asyncpg://greentube:greentube@localhost:5432/greentube

# MongoDB Atlas — primary catalog database
MONGODB_URI=
MONGODB_DATABASE=greentube
AUTO_SEED_MONGO=true

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (R2 / S3-compatible)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=greentube
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Catalog providers
MUSICBRAINZ_USER_AGENT=GreenTubeMusic/0.1.0 (dev@localhost)
JAMENDO_CLIENT_ID=

# Admin catalog import (server only — never commit real keys)
ADMIN_API_KEY=

# Full playback: false = no Deezer 30s previews (Audius/Jamendo/local only)
ALLOW_PREVIEW_PLAYBACK=false

# Spotify — full playback (Spotify Premium required in browser)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/integrations/spotify/callback

# Optional licensed providers (later)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=
